# Токен от @BotFather
BOT_TOKEN=
# HTTPS-адрес этого же сервиса на Render (Mini App отдаётся самим ботом)
WEBAPP_URL=https://
# Ключ OpenRouter (ИИ-наставник)
OPENROUTER_API_KEY=
